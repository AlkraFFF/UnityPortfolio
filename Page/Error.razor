@using System.Diagnostics

<PageTitle>Error | System Malfunction</PageTitle>

<div class="container" style="text-align: center; padding: 6rem 0;">
    <div class="glass-panel" style="max-width: 600px; margin: 0 auto; padding: 3rem 2rem; border-radius: 12px; border-color: rgba(255, 68, 68, 0.3);">
        <h1 style="color: #ff4444; font-size: 2.5rem; margin-bottom: 1rem; font-family: var(--font-mono);">[ SYSTEM_ERROR ]</h1>
        <p style="color: var(--text-secondary); margin-bottom: 1.5rem;">
            An unhandled runtime exception occurred during execution.
        </p>

        @if (ShowRequestId)
        {
            <p style="font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-muted); margin-bottom: 2rem;">
                Trace ID: <code style="color: var(--accent-cyan);">@RequestId</code>
            </p>
        }

        <a href="" class="btn btn-primary">Return to Base</a>
    </div>
</div>

@code {
    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized()
    {
        // В WebAssembly берем текущий Activity ID или генерируем уникальный GUID сессии
        RequestId = Activity.Current?.Id ?? Guid.NewGuid().ToString("N");
    }
}